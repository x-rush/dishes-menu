# ─────────────────────────────────────────────────────────
# 每周菜品安排 — Environment configuration
# Copy this to .env and fill in your real values
# ─────────────────────────────────────────────────────────

# Time zone (affects log timestamps; dates are still ISO in DB)
TZ=Asia/Shanghai

# Server port (must match docker-compose.prod.yml ports mapping)
PORT=8080

# MySQL DSN — go-sql-driver/mysql format
# Components: user:password@tcp(host:port)/dbname?params
# Required params: charset=utf8mb4, parseTime=true, loc=Local
#
# Examples:
#   Local:  root:secret@tcp(127.0.0.1:3306)/dishes_menu?charset=utf8mb4&parseTime=true&loc=Local
#   Remote:  app_user:s3cret@tcp(10.0.0.5:3306)/dishes_menu?charset=utf8mb4&parseTime=true&loc=Local
#
# Before first run, make sure the database exists:
#   mysql -h 127.0.0.1 -u root -p -e "CREATE DATABASE IF NOT EXISTS dishes_menu DEFAULT CHARSET utf8mb4 COLLATE utf8mb4_unicode_ci;"
MYSQL_DSN=root:password@tcp(127.0.0.1:3306)/dishes_menu?charset=utf8mb4&parseTime=true&loc=Local
